# Copy to Streamlit Cloud → App settings → Secrets (and optionally local .streamlit/secrets.toml).
# Creates/updates aggregates on branch "appdata" — does not trigger a main-branch redeploy.

[github_store]
token = "ghp_xxxxxxxx"          # fine-grained PAT: Contents read/write on this repo
owner = "your-github-username"
repo = "azshipsales"
branch = "appdata"
path = "aggregates.json"
